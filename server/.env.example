NODE_ENV=development
# Normal sign-up/sign-in uses email and an emailed verification code.
AUTH_LOGIN_METHOD=email
# Keep both shortcuts false to require verification codes.
# A shortcut only applies to its configured method, and is forbidden in production.
DEV_SKIP_EMAIL_OTP=false
# Legacy phone mode is available only when AUTH_LOGIN_METHOD=phone is explicitly selected.
DEV_SKIP_PHONE_OTP=false
# 'development' prints test codes only in the server terminal, never sends SMS.
# Keep disabled until configured; actual local development may explicitly select development.
# For the free trial use 'twilio-verify' with the real trial account credentials below.
# See ../PHONE_AUTH.md. Development delivery is forbidden in production.
SMS_PROVIDER=disabled
# TWILIO_ACCOUNT_SID=AC... (32 hex characters after AC)
# TWILIO_AUTH_TOKEN=your-real-trial-account-token-not-Test-Credentials
# Copy the VA Service SID from Identity > Verify > Overview > Try out Verify API request.
# TWILIO_VERIFY_SERVICE_SID=VA... (32 hex characters after VA)
# Verify does not need TWILIO_FROM; only legacy SMS_PROVIDER=twilio needs a sender.
# TWILIO_FROM=your-Twilio-sender
# After changing server/.env, from server: docker compose up -d --force-recreate backend worker
# Generate a private 32-byte hex key for national ID storage; back it up securely.
# PROFILE_ENCRYPTION_KEY=64-hex-characters
PORT=4000
# Docker publishes the API only on this computer by default.
# Set to the computer's LAN address only for deliberate, trusted-network device testing.
BACKEND_BIND_ADDRESS=127.0.0.1
ROAD_REPORT_EXPIRY_TRAFFIC_CONGESTION_MINUTES=30
ROAD_REPORT_EXPIRY_ACCIDENT_MINUTES=90
ROAD_REPORT_EXPIRY_CHECKPOINT_MINUTES=60
ROAD_REPORT_EXPIRY_ROAD_HAZARD_MINUTES=240
ROAD_REPORT_EXPIRY_CONSTRUCTION_MINUTES=1440
ROAD_REPORT_EXPIRY_CLOSED_ROAD_MINUTES=360
ROAD_REPORT_EXPIRY_POLICE_MINUTES=45
ROAD_REPORT_EXPIRY_OTHER_MINUTES=60
ROAD_REPORT_DUPLICATE_TRAFFIC_CONGESTION_METERS=150
ROAD_REPORT_DUPLICATE_TRAFFIC_CONGESTION_MINUTES=30
ROAD_REPORT_DUPLICATE_CHECKPOINT_METERS=120
ROAD_REPORT_DUPLICATE_CHECKPOINT_MINUTES=60
ROAD_REPORT_DUPLICATE_POLICE_METERS=120
ROAD_REPORT_DUPLICATE_POLICE_MINUTES=45
ROAD_REPORT_DUPLICATE_ACCIDENT_METERS=100
ROAD_REPORT_DUPLICATE_ACCIDENT_MINUTES=90
ROAD_REPORT_DUPLICATE_CLOSED_ROAD_METERS=100
ROAD_REPORT_DUPLICATE_CLOSED_ROAD_MINUTES=360
ROAD_REPORT_DUPLICATE_ROAD_HAZARD_METERS=75
ROAD_REPORT_DUPLICATE_ROAD_HAZARD_MINUTES=240
ROAD_REPORT_DUPLICATE_CONSTRUCTION_METERS=100
ROAD_REPORT_DUPLICATE_CONSTRUCTION_MINUTES=1440
ROAD_REPORT_DUPLICATE_OTHER_METERS=75
ROAD_REPORT_DUPLICATE_OTHER_MINUTES=60
DATABASE_URL=postgresql://parkflow:local-parkflow@localhost:5434/parkflow
TEST_DATABASE_URL=postgresql://parkflow:local-parkflow@localhost:5434/parkflow_test
REDIS_URL=redis://localhost:6381
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:19006
OSRM_BASE_URL=https://router.project-osrm.org
PAYMENT_PROVIDER=development
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters-webhook
S3_ENDPOINT=http://localhost:9002
# Public hostname for signed URLs when the backend uses an internal Docker S3 hostname
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=parkflow
S3_ACCESS_KEY=parkflow-local
S3_SECRET_KEY=parkflow-local-storage
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
EXPO_PUSH_ACCESS_TOKEN=
SEED_ADMIN_EMAIL=

EMAIL_PROVIDER=smtp
EMAIL_FROM=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASSWORD=
