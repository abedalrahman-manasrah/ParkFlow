{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "parkflow-customer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--workspace",
        "@parkflow/customer",
        "--",
        "--clear"
      ],
      "port": 8081
    },
    {
      "name": "parkflow-management",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--workspace", "@parkflow/management", "--", "--clear"],
      "port": 8082
    }
  ]
}
