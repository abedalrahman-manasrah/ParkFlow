  "dataPolicyAr": [
    "لا تخمّن الإحداثيات ولا ساعات العمل أو الرسوم؛ استخدم null للمجهول.",
    "mapReady يعبر عن وجود إحداثية مصدرية لا عن التحقق الميداني أو إمكانية الوصول.",
    "بيانات المساجد لا تعني تأكيد وجود مصليات نسائية أو وضوء أو دورات مياه.",
    "تحقق من الإتاحة ومداخل الأماكن قبل اعتماد التوجيه الملاحي.",
    "احرص على عدم تكرار سجلات الحدائق الموجودة أصلًا في طبقة Tourism؛ يمكن ربط نفس المكان بتصنيف إضافي."
  ],
  "integrationNotesAr": [
    "ملف JSON مستقل لا يغيّر الكود؛ يحتاج Importer وAPI وMap Layer عند الدمج.",
    "استخدم id ثابتًا للإدخال أو التحديث وتجنب التكرار في قاعدة البيانات.",
    "اعرض Marker فقط إذا mapReady=true.",
    "اعرض التصنيفات منفصلة عند التصفية، واحتفظ بالبيانات القديمة دون حذف.",
    "للأماكن غير الجاهزة: لا تُنشئ Marker ولا تفعّل توجيه الملاحة؛ يمكن إظهارها في قائمة بحث مع حالة غير محدد على الخريطة.",
    "الإضافات الثمانية الجديدة مصدرها صفحات خرائط منشورة، وبعض إسنادها الإداري للمدينة يحتاج مراجعة مع حدود البلدية؛ لا تعلن اكتمال التغطية."
  ],
